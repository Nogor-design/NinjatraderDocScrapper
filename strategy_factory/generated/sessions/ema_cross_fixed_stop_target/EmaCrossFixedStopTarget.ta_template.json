  "max_hold_bars": 20,
  "flatten_on_session_end": true,
  "factory_metadata": {
    "schema_version": "0.1",
    "strategy_id": "EmaCrossFixedStopTarget",
    "source_prompt": "EMA 9/21 crossover, both directions, 20 tick stop, 40 tick target, fixed 1 contract, trade 08:30-11:30 America/Denver, on bar close, max 3 trades/day.",
    "risk": {
      "max_trades_per_day": 3,
      "use_soft_pnl_lock": true,
      "soft_profit_stop": 10000.0,
      "soft_loss_stop": 10000.0,
