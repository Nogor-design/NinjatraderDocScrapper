        private {{FAST_INDICATOR_TYPE}} fastMa;
        private {{SLOW_INDICATOR_TYPE}} slowMa;
{{FILTER_FIELD_DECLARATIONS}}
        private bool riskLocked;
        private int priorTradesCount;
        private double priorTradesCumProfit;
